# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# New-style API keys (Settings → API Keys). Publishable = client/browser (anon/authenticated, RLS applies).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# Secret = server-only (service_role, bypasses RLS). Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Resend (email sending)
RESEND_API_KEY=re_your-resend-api-key
