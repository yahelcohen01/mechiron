# ============================================================
# scripts/.env.migration  — credentials for migrate-to-new-project.sh
#
# HOW TO USE:
#   1. Copy this file:   cp scripts/.env.migration.example scripts/.env.migration
#   2. Fill in the values below.
#   3. Run:              ./scripts/migrate-to-new-project.sh
#
# The real scripts/.env.migration is gitignored — NEVER commit real credentials.
# ============================================================

# REQUIRED — full Postgres connection string for the NEW (empty) project.
# Get it from: Supabase Dashboard -> new project -> "Connect" ->
#   "Connection string" (URI). Prefer the "Session pooler" string (IPv4-friendly).
# Percent-encode the password if it contains special characters (@ : / ? # etc.).
TARGET_DB_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# OPTIONAL — only used with the --write-env flag, which points the app at the new
# project by updating .env.local (a timestamped backup is made first).
# Get these from: Dashboard -> Project Settings -> API.
NEW_SUPABASE_URL=
NEW_SUPABASE_ANON_KEY=
NEW_SUPABASE_SERVICE_ROLE_KEY=
